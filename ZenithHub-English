local function canAttack(targetPlayer)
    if not targetPlayer or not targetPlayer.Parent then return false end
    local char = targetPlayer.Character
    if not char or not char:IsDescendantOf(workspace) then return false end
    
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    
    if not humanoid or not hrp then return false end
    if humanoid.Health <= 0 or humanoid:GetState() == Enum.HumanoidStateType.Dead then return false end
    if char:FindFirstChildOfClass("ForceField") then return false end
    
    return true
end

task.spawn(function()
    local keyMap = {
        [1] = Enum.KeyCode.One,
        [2] = Enum.KeyCode.Two,
        [3] = Enum.KeyCode.Three,
        [4] = Enum.KeyCode.Four,
        [5] = Enum.KeyCode.Five,
    }
    
    while true do
        if farmEnabled then
            local targets = {}
            for name in string.gmatch(targetInputText, "[^,%s]+") do
                local p = Players:FindFirstChild(name)
                if p then table.insert(targets, p) end
            end
            
            local activeTarget = nil
            for _, tPlayer in ipairs(targets) do
                if canAttack(tPlayer) then
                    activeTarget = tPlayer
                    break
                end
            end
            
            if activeTarget and activeTarget.Character and activeTarget.Character:FindFirstChild("HumanoidRootPart") then
                local myChar = LocalPlayer.Character
                if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                    if canAttack(activeTarget) then
                        myChar.HumanoidRootPart.CFrame = activeTarget.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                        
                        for i = 1, 5 do
                            if not farmEnabled or not canAttack(activeTarget) then break end
                            if selectedSkills[i] then
                                pcall(function()
                                    VirtualInputManager:SendKeyEvent(true, keyMap[i], false, game)
                                    task.wait(0.03)
                                    VirtualInputManager:SendKeyEvent(false, keyMap[i], false, game)
                                end)
                                task.wait(0.2)
                            end
                        end
                    else
                        task.wait(0.3)
                    end
                end
            else
                task.wait(0.3)
            end
        else
            task.wait(0.5)
        end
        task.wait(0.05)
    end
end)

-- ================= Speed Tab =================
local SpeedTab = Window:Tab({
    Title = "Speed",
    Icon = "gauge",
})

local speedEnabled = false
local currentForce = nil
local hasForceSet = false
local speedConnection = nil

local function showNumberWarning()
    WindUI:Popup({
        Title = "Warning",
        Icon = "alert-triangle",
        Content = "Please enter a number!",
        Buttons = {
            { Title = "OK", Variant = "Primary" }
        }
    })
end

local function startSpeedControl()
    if speedConnection then return end
    speedConnection = RunService.Heartbeat:Connect(function()
        if not speedEnabled then return end
        local character = LocalPlayer.Character
        if not character then return end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not hrp then return end

        local moveDirection = humanoid.MoveDirection
        local state = humanoid:GetState()

        if state == Enum.HumanoidStateType.Swimming
            or state == Enum.HumanoidStateType.Freefall
            or state == Enum.HumanoidStateType.Climbing then
            if moveDirection.Magnitude > 0 then
                hrp.AssemblyLinearVelocity = Camera.CFrame.LookVector.Unit * currentForce * moveDirection.Magnitude
            else
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
        else
            local horizontalVelocity = moveDirection * currentForce
            local currentVelocity = hrp.AssemblyLinearVelocity
            hrp.AssemblyLinearVelocity = Vector3.new(horizontalVelocity.X, currentVelocity.Y, horizontalVelocity.Z)
        end
    end)
end

local function stopSpeedControl()
    if speedConnection then
        speedConnection:Disconnect()
        speedConnection = nil
    end
    local character = LocalPlayer.Character
    if character then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
        end
    end
end

SpeedTab:Input({
    Title = "Enter Speed Value",
    PlaceholderText = "e.g. 16, 50, 100",
    Callback = function(text)
        if text == nil or text == "" then
            hasForceSet = false
            return
        end

        local num = tonumber(text)
        if num then
            currentForce = num
            hasForceSet = true
        else
            hasForceSet = false
            showNumberWarning()
        end
    end
})

SpeedTab:Toggle({
    Title = "Toggle Speed",
    Default = false,
    Callback = function(state)
        if state and not hasForceSet then
            showNumberWarning()
            speedEnabled = false
            return
        end

        speedEnabled = state
        if state then
            startSpeedControl()
        else
            stopSpeedControl()
        end
    end
})

