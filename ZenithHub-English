local function updatePlayerList()
    for _, btn in ipairs(playerButtons) do
        pcall(function() btn:Destroy() end)
    end
    playerButtons = {}

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local pBtn = PlayerListSection:Button({
                Title = "➕ Add: " .. p.Name,
                Callback = function()
                    if targetInputText == "" then
                        targetInputText = p.Name
                    else
                        targetInputText = targetInputText .. ", " .. p.Name
                    end
                    TargetInput:SetValue(targetInputText)
                end
            })
            table.insert(playerButtons, pBtn)
        end
    end
end

